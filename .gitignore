# ColorCode 根目录 .gitignore
# 原则：只提交代码、配置、分析脚本和文档；模型权重、数据集、推理输出、日志、缓存一律不提交。

# ===== 模型权重 / checkpoint（任意位置）=====
*.pth
*.pt
*.pkl
*.ckpt
*.safetensors
*.bin
*.onnx
*.h5
checkpoint/
checkpoints/
weights/

# ===== 数据集 =====
ReDDiT/dataset/
Diff-Retinex/test_dataset/

# ===== 推理输入/输出、实验结果（体积大、可重新生成）=====
result/
ReDDiT/output/
ReDDiT/input/
ReDDiT/temp/
ReDDiT/results/
Diff-Retinex/input/
Diff-Retinex/offical_results/
HVI-CIDNet/input/
HVI-CIDNet/output_hf/
HVI-CIDNet/pic/
TADSR/experience/
TADSR/output/
TADSR/preset/datasets/
Retinexformer/experiments/
Retinexformer/pretrained_weights/
CWNet-Causal-Wavelet-Network/experiments/
CWNet-Causal-Wavelet-Network/results/

# ===== 日志 / TensorBoard / 缓存 =====
*.log
logs/
tb_logger/
events.out.tfevents.*
*.pid
wandb/
analysis/consistency_cache/

# ===== Python / IDE / 系统文件 =====
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ===== 子目录原有的 git 仓库（已改名保留，不提交）=====
.git_upstream/
